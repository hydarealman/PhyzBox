; PhyzBox Godot frontend. The authoritative simulation runs in libphyz.
config_version=5

[application]
config/name="PhyzBox：余烬航线"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.025, 1)

[input]
pause_simulation={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32)]}
time_faster={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":61)]}
time_slower={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":45)]}
