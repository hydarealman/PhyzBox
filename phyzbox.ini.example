# Optional PhyzBox initial-condition config.
# Copy this file to phyzbox.ini to use it.
# Units: AU, solar masses, years. Velocity is AU/year.

body_count = 4

# Optional global tuning. Omit these to use automatic defaults.
# physics_dt = 0.00010
# camera_distance = 8.0
# softening = 0.008

[body0]
name = "Alpha"
type = star
mass = 1.4
radius = 0.13
# Optional real collision radius. Omit for solar-radius estimate.
# physical_radius = 0.006
color = 1.0, 0.40, 0.22
# Optional spin state. rotation_period is in years, angle is degrees.
spin_axis = 0.15, 0.30, 1.0
rotation_period = 0.062
rotation_angle = 15
position = -1.30, -0.20, 0.35
velocity = 0.60, 2.40, -0.70

[body1]
name = "Beta"
type = star
mass = 1.0
radius = 0.11
color = 0.25, 0.65, 1.0
position = 1.15, -0.75, -0.25
velocity = -2.20, 0.35, 1.50

[body2]
name = "Gamma"
type = star
mass = 0.9
radius = 0.10
color = 0.95, 0.85, 0.35
position = 0.35, 1.10, 0.10
velocity = 1.25, -3.00, -0.80

[body3]
name = "Delta"
type = planet
mass = 0.003
radius = 0.055
color = 0.55, 1.0, 0.72
spin_axis = -0.35, 0.10, 1.0
rotation_period = 0.0027
position = -0.20, 0.25, -0.70
velocity = 0.45, 0.10, 1.80
